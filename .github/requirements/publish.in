# The release job of release.yml holds the PyPI token; it builds and uploads with these and installs nothing else.
# publish.txt is generated from this file:
# uv pip compile .github/requirements/publish.in --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_28 --only-binary :all: --exclude-newer <7 days ago> -o .github/requirements/publish.txt
# (--python-version is the one the job sets up. --exclude-newer keeps the 7-day wait Dependabot uses
# elsewhere: nothing uploaded in the last week.)
# Updated by hand: change a version here and regenerate with the command above. Dependabot does not watch
# this folder, because it regenerated publish.txt without setuptools and broke the lock checks (#231, #232).
build==1.6.1
twine==6.2.0
# The build backend. The job runs `python -m build --no-isolation`, so the backend is this locked one and
# not whatever is newest on PyPI when the job runs. It must satisfy `build-system.requires` in stable.toml,
# which the job builds from, and in pyproject.toml (tests/test_workflow_actions.py).
setuptools==84.2.1
