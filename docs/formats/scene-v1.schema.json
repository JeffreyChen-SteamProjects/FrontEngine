{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontengine:scene:v1",
  "title": "FrontEngine scene envelope version 1",
  "type": "object",
  "required": [
    "format",
    "version",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "frontengine.scene"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "script_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 16,
              "maximum": 4096
            },
            {
              "type": "integer",
              "minimum": 16,
              "maximum": 4096
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "motion": {
          "type": [
            "string",
            "null"
          ]
        },
        "expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "width": {
          "type": "number",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "number",
          "minimum": 16,
          "maximum": 8192
        },
        "scale": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "rotation": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "PUPPET"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "file_path"
            ]
          }
        }
      ]
    }
  }
}
